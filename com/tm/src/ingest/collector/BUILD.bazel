load("@rules_go//go:def.bzl", "go_library", "go_test")
load("//tools/rules:com_tm_container.bzl", "com_tm_go_image")

# Nhận DataEvent (4 loại payload) qua HTTP.
#   bazel run //com/tm/src/ingest/collector:event_collector
#   bazel run --config=linux-arm64 //com/tm/src/ingest/collector:event_collector_docker
com_tm_go_image(
    name = "event_collector",
    package_name = package_name(),
    embed = [":collector_lib"],
    exposed_ports = ["8080/tcp"],
    visibility = ["//visibility:public"],
)

go_library(
    name = "collector_lib",
    srcs = [
        "main.go",
        "validate.go",
    ],
    importpath = "com.tm/vision/com/tm/src/ingest/collector",
    visibility = ["//visibility:private"],
    deps = [
        "//com/tm/proto/vision/catalog/v1:catalog_go_proto",
        "//com/tm/proto/vision/event/v1:event_go_proto",
        "@com_github_prometheus_client_golang//prometheus",
        "@com_github_prometheus_client_golang//prometheus/promhttp",
        "@org_golang_google_protobuf//encoding/protojson",
    ],
)

go_test(
    name = "collector_test",
    srcs = ["validate_test.go"],
    embed = [":collector_lib"],
    deps = [
        "//com/tm/proto/vision/catalog/v1:catalog_go_proto",
        "//com/tm/proto/vision/event/v1:event_go_proto",
        "@com_github_prometheus_client_golang//prometheus",
    ],
)
