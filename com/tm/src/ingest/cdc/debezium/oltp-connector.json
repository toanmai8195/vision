{
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "tasks.max": "1",
  "database.hostname": "postgres-oltp",
  "database.port": "5432",
  "database.user": "vision",
  "database.password": "vision",
  "database.dbname": "oltp",
  "topic.prefix": "oltp",
  "plugin.name": "pgoutput",
  "slot.name": "vision_oltp",
  "publication.name": "vision_oltp_pub",
  "publication.autocreate.mode": "filtered",
  "schema.include.list": "src",
  "snapshot.mode": "initial",
  "decimal.handling.mode": "string",
  "key.converter": "org.apache.kafka.connect.json.JsonConverter",
  "key.converter.schemas.enable": "false",
  "value.converter": "org.apache.kafka.connect.json.JsonConverter",
  "value.converter.schemas.enable": "false",
  "tombstones.on.delete": "false",
  "message.key.columns": "src.payment_event:user_id;src.user_profile:user_id;src.user_product:user_id;src.voucher_grant:user_id;src.oa_follow:user_id;src.app_event:user_id",
  "transforms": "route",
  "transforms.route.type": "io.debezium.transforms.ByLogicalTableRouter",
  "transforms.route.topic.regex": "oltp\\.src\\.(.*)",
  "transforms.route.topic.replacement": "vision.src.$1.v1",
  "transforms.route.key.enforce.uniqueness": "false"
}
