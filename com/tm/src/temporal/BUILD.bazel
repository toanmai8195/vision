load("@rules_python//python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

# P1 — semantics core thuần (CLAUDE.md §4). Không cần StarRocks/Spark.
py_library(
    name = "temporal",
    srcs = [
        "blocks.py",
        "engine.py",
        "latest.py",
        "model.py",
        "planner.py",
        "ranges.py",
    ],
    deps = [
        "//com/tm/proto/vision/catalog/v1:catalog_py_proto",
        "@pypi//pyroaring",
    ],
)

py_library(
    name = "reference",
    srcs = ["reference.py"],
    deps = [
        ":temporal",
        "@pypi//pyroaring",
    ],
)

py_library(
    name = "testing",
    testonly = True,
    srcs = ["testing.py"],
    deps = [
        ":temporal",
        "//com/tm/proto/vision/segment/v1:segment_py_proto",
        "@pypi//pyroaring",
        "@pypi//pyyaml",
    ],
)

filegroup(
    name = "golden",
    srcs = glob(["testdata/golden/*.yaml"]),
)

[
    py_test(
        name = name,
        srcs = [name + ".py"],
        deps = [
            ":reference",
            ":temporal",
            ":testing",
            "@pypi//pyroaring",
            "@pypi//pytest",
        ],
    )
    for name in [
        "blocks_test",
        "engine_test",
        "latest_test",
        "model_test",
        "planner_test",
        "ranges_test",
    ]
]

py_test(
    name = "golden_test",
    srcs = ["golden_test.py"],
    data = [":golden"],
    deps = [
        ":reference",
        ":temporal",
        ":testing",
        "//com/tm/src/segment/dsl",
        "@pypi//pyroaring",
        "@pypi//pytest",
    ],
)

# Property test: engine (planner → daily → block → LATEST → range) == reference, ≥ 10K case / tổ hợp.
# Mỗi tổ hợp (kind, aggFunc, attributeType) một target để chạy song song.
PROPERTY_COMBOS = [
    # P1: 4 loại × EVENT/STATE (aggFunc SUM, STANDARD)
    ("MUTEX_EVENT", "SUM", "STANDARD"),
    ("MUTEX_STATE", "SUM", "STANDARD"),
    ("NOT_MUTEX_EVENT", "SUM", "STANDARD"),
    ("NOT_MUTEX_STATE", "SUM", "STANDARD"),
    ("PARTIAL_VALUE", "SUM", "STANDARD"),
    ("PARTIAL_VALUE_BY_TAG", "SUM", "STANDARD"),
    # P1b: aggFunc COUNT / MIN / MAX
    ("PARTIAL_VALUE", "COUNT", "STANDARD"),
    ("PARTIAL_VALUE", "MIN", "STANDARD"),
    ("PARTIAL_VALUE", "MAX", "STANDARD"),
    ("PARTIAL_VALUE_BY_TAG", "COUNT", "STANDARD"),
    ("PARTIAL_VALUE_BY_TAG", "MIN", "STANDARD"),
    ("PARTIAL_VALUE_BY_TAG", "MAX", "STANDARD"),
    # P1b: EXTENDED (usage-driven)
    ("NOT_MUTEX_EVENT", "SUM", "EXTENDED"),
    ("NOT_MUTEX_STATE", "SUM", "EXTENDED"),
    ("PARTIAL_VALUE_BY_TAG", "SUM", "EXTENDED"),
]

[
    py_test(
        # P1 giữ tên cũ: property_test_<kind>; P1b thêm hậu tố _<agg> / _extended
        name = "property_test_" + kind.lower() + ("" if agg == "SUM" else "_" + agg.lower()) + ("_extended" if attr_type == "EXTENDED" else ""),
        size = "large",
        srcs = ["property_test.py"],
        env = {
            "PROPERTY_AGG": agg,
            "PROPERTY_ATTR_TYPE": attr_type,
            "PROPERTY_KIND": kind,
        },
        main = "property_test.py",
        deps = [
            ":reference",
            ":temporal",
            ":testing",
            "@pypi//hypothesis",
            "@pypi//pyroaring",
            "@pypi//pytest",
        ],
    )
    for kind, agg, attr_type in PROPERTY_COMBOS
]
