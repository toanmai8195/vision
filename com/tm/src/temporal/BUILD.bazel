load("@rules_python//python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

# P1 — semantics core thuần (CLAUDE.md §4). Không cần StarRocks/Spark.
py_library(
    name = "temporal",
    srcs = [
        "blocks.py",
        "engine.py",
        "latest.py",
        "model.py",
        "planner.py",
        "ranges.py",
    ],
    deps = [
        "//com/tm/proto/vision/catalog/v1:catalog_py_proto",
        "@pypi//pyroaring",
    ],
)

py_library(
    name = "reference",
    srcs = ["reference.py"],
    deps = [
        ":temporal",
        "@pypi//pyroaring",
    ],
)

py_library(
    name = "testing",
    testonly = True,
    srcs = ["testing.py"],
    deps = [
        ":temporal",
        "//com/tm/proto/vision/segment/v1:segment_py_proto",
        "@pypi//pyroaring",
        "@pypi//pyyaml",
    ],
)

filegroup(
    name = "golden",
    srcs = glob(["testdata/golden/*.yaml"]),
)

[
    py_test(
        name = name,
        srcs = [name + ".py"],
        deps = [
            ":reference",
            ":temporal",
            ":testing",
            "@pypi//pyroaring",
            "@pypi//pytest",
        ],
    )
    for name in [
        "blocks_test",
        "latest_test",
        "model_test",
        "planner_test",
        "ranges_test",
    ]
]

py_test(
    name = "golden_test",
    srcs = ["golden_test.py"],
    data = [":golden"],
    deps = [
        ":reference",
        ":temporal",
        ":testing",
        "//com/tm/src/segment/dsl",
        "@pypi//pyroaring",
        "@pypi//pytest",
    ],
)

# Property test: engine (planner → daily → block → LATEST → range) == reference, ≥ 10K case / loại.
# Mỗi (dataType, feedMode) một target để chạy song song.
[
    py_test(
        name = "property_test_" + kind.lower(),
        size = "large",
        srcs = ["property_test.py"],
        env = {"PROPERTY_KIND": kind},
        main = "property_test.py",
        deps = [
            ":reference",
            ":temporal",
            ":testing",
            "@pypi//hypothesis",
            "@pypi//pyroaring",
            "@pypi//pytest",
        ],
    )
    for kind in [
        "MUTEX_EVENT",
        "MUTEX_STATE",
        "NOT_MUTEX_EVENT",
        "NOT_MUTEX_STATE",
        "PARTIAL_VALUE",
        "PARTIAL_VALUE_BY_TAG",
    ]
]
