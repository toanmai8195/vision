common --enable_bzlmod
test --test_output=errors
try-import %workspace%/.bazelrc.user

# rules_oci: CopyToDirectory / CopyFile không chạy được trong darwin-sandbox
build --strategy=CopyToDirectory=local
build --strategy=CopyFile=local
build --repo_env=DOCKER_CONFIG=/dev/null

# Go thuần, không CGO (image distroless)
build --@rules_go//go/config:pure
build --action_env=CGO_ENABLED=0

# Java 17 (Flink 1.20 hỗ trợ chính thức)
build --java_language_version=17
build --java_runtime_version=remotejdk_17
build --tool_java_language_version=17
build --tool_java_runtime_version=remotejdk_17

# Image đúng kiến trúc máy chạy container:
#   bazel run --config=linux-arm64 <target>_docker   (Mac Apple Silicon)
build:linux-amd64 --platforms=//:linux_amd64
build:linux-arm64 --platforms=//:linux_arm64
